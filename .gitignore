# Private runtime data and generated output. Keep directory documentation.
/data/*
!/data/README.md
/dist/*
!/dist/README.md
/downloads/*
!/downloads/README.md
/artifacts/*
!/artifacts/README.md
/.runtime/*
!/.runtime/README.md
/runtime/
/offline-translation/runtime/
/offline-translation/model/*
!/offline-translation/model/README.md

# Dependencies, local configuration and tool output.
node_modules/
.next/
out/
.wrangler/
.dev.vars
!.dev.vars.example
coverage/
__pycache__/
*.py[cod]
.cache/
.env
.env.*
!.env.example
.idea/
.vscode/

# Logs, editor backups and operating-system files.
*.log
*.tmp
*.temp
*.bak
*.swp
*.swo
*~
.DS_Store
Thumbs.db
Desktop.ini
